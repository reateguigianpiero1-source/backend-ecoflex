@model IEnumerable<TiendaHerramientas.Models.Producto>

@{
    ViewBag.Title = "Productos";
}

<h2>Productos</h2>

<p>
    @Html.ActionLink("Nuevo producto", "Create", null, new { @class = "btn btn-primary" })
</p>

@using (Html.BeginForm("Index", "Productos", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom: 15px;" }))
{
    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o SKU" />
    @Html.DropDownList("categoriaId", (SelectList)ViewBag.CategoriaId, "Todas las categorías", new { @class = "form-control" })
    <button type="submit" class="btn btn-default">Buscar</button>
    @Html.ActionLink("Limpiar filtros", "Index", null, new { @class = "btn btn-link" })
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay productos que coincidan. Crea uno con el botón "Nuevo producto" o cambia los filtros.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Sku</td>
                    <td>@Html.ActionLink(item.Nombre, "Details", new { id = item.Id })</td>
                    <td>@(item.Categoria != null ? item.Categoria.Nombre : "")</td>
                    <td>S/ @item.PrecioVenta.ToString("N2")</td>
                    <td>
                        @if (item.Inventario == null)
                        {
                            <span class="text-muted">Sin inventario</span>
                        }
                        else if (item.Inventario.StockDisponible <= 0)
                        {
                            <span class="label label-danger">Agotado</span>
                        }
                        else if (item.Inventario.StockBajo)
                        {
                            <span class="label label-warning">@item.Inventario.StockDisponible (stock bajo)</span>
                        }
                        else
                        {
                            <span class="label label-success">@item.Inventario.StockDisponible</span>
                        }
                    </td>
                    <td class="text-right">
                        @Html.ActionLink("Ver", "Details", new { id = item.Id }) |
                        @Html.ActionLink("Editar", "Edit", new { id = item.Id }) |
                        @Html.ActionLink("Desactivar", "Delete", new { id = item.Id })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
