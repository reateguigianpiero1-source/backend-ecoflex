@model IEnumerable<TiendaHerramientas.Models.Inventario>

@{
    ViewBag.Title = "Inventario";
    bool soloBajo = ViewBag.SoloStockBajo != null && (bool)ViewBag.SoloStockBajo;
}

<h2>Inventario</h2>

<ul class="nav nav-pills" style="margin-bottom: 15px;">
    <li class="@(!soloBajo ? "active" : "")">@Html.ActionLink("Todos", "Index", new { soloStockBajo = false })</li>
    <li class="@(soloBajo ? "active" : "")">@Html.ActionLink("Stock bajo", "Index", new { soloStockBajo = true })</li>
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(soloBajo ? "Ningún producto tiene el stock bajo." : "Todavía no hay productos en el inventario. Crea un producto y aparecerá aquí.")
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Stock actual</th>
                <th>Reservado</th>
                <th>Disponible</th>
                <th>Mínimo</th>
                <th>Ubicación</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Producto.Nombre
                        <br />
                        <small class="text-muted">@item.Producto.Sku</small>
                    </td>
                    <td>@item.StockActual</td>
                    <td>@item.StockReservado</td>
                    <td>
                        @if (item.StockBajo)
                        {
                            <span class="label label-warning">@item.StockDisponible (stock bajo)</span>
                        }
                        else
                        {
                            <span class="label label-success">@item.StockDisponible</span>
                        }
                    </td>
                    <td>@item.StockMinimo</td>
                    <td>@(string.IsNullOrEmpty(item.Ubicacion) ? "—" : item.Ubicacion)</td>
                    <td class="text-right">
                        @Html.ActionLink("Registrar movimiento", "Registrar", new { id = item.ProductoId }) |
                        @Html.ActionLink("Historial", "Movimientos", new { id = item.ProductoId }) |
                        @Html.ActionLink("Configurar", "Configurar", new { id = item.ProductoId })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
