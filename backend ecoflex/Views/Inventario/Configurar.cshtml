@model TiendaHerramientas.Models.Inventario

@{
    ViewBag.Title = "Configurar inventario";
}

<h2>Configurar inventario</h2>
<h4>@Model.Producto.Nombre <small>@Model.Producto.Sku</small></h4>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-horizontal">

        <div class="form-group">
            @Html.LabelFor(m => m.StockMinimo, new { @class = "control-label col-md-2" })
            <div class="col-md-2">
                @Html.EditorFor(m => m.StockMinimo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.StockMinimo, "", new { @class = "text-danger" })
                <span class="help-block">Cuando el stock disponible llegue a este número, el producto aparece como stock bajo.</span>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Ubicacion, new { @class = "control-label col-md-2" })
            <div class="col-md-4">
                @Html.EditorFor(m => m.Ubicacion, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: Almacén A, estante 3" } })
                @Html.ValidationMessageFor(m => m.Ubicacion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
