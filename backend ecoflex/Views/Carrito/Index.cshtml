@model TiendaHerramientas.Models.Carrito

@{
    ViewBag.Title = "Mi carrito";
}

<h2>Mi carrito</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Tu carrito está vacío.
        @Html.ActionLink("Ver productos", "Index", "Productos")
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th class="text-right">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@Html.ActionLink(item.Producto.Nombre, "Details", "Productos", new { id = item.ProductoId }, null)</td>
                    <td>S/ @item.PrecioUnitario.ToString("N2")</td>
                    <td>
                        @using (Html.BeginForm("ActualizarCantidad", "Carrito", FormMethod.Post, new { @class = "form-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="number" name="cantidad" value="@item.Cantidad" min="1" class="form-control input-sm" style="width: 80px;" />
                            <button type="submit" class="btn btn-default btn-sm">Actualizar</button>
                        }
                    </td>
                    <td class="text-right">S/ @item.Subtotal.ToString("N2")</td>
                    <td class="text-right">
                        @using (Html.BeginForm("Quitar", "Carrito", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-link btn-sm text-danger">Quitar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Total (@Model.CantidadTotal artículos)</th>
                <th class="text-right">S/ @Model.Total.ToString("N2")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div>
        @Html.ActionLink("Seguir comprando", "Index", "Productos", null, new { @class = "btn btn-default" })

        @using (Html.BeginForm("Vaciar", "Carrito", FormMethod.Post, new { style = "display: inline;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-danger">Vaciar carrito</button>
        }
    </div>
}
